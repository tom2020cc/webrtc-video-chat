[Unit]
Description=WebRTC Video Chat
After=network.target

[Service]
Type=simple
User=webrtc-video
Group=webrtc-video
WorkingDirectory=/www/wwwroot/webrtc-video-chat
EnvironmentFile=/etc/webrtc-video.env
ExecStart=/www/server/nvm/versions/node/v22.23.2/bin/node server/app.js
Restart=on-failure
RestartSec=5
StateDirectory=webrtc-video
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=512M
CPUQuota=100%
TasksMax=128
UMask=0027

[Install]
WantedBy=multi-user.target
