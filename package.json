{
  "name": "webrtc-video-chat",
  "version": "2.0.0",
  "description": "基于 Express + Socket.IO + PeerJS 的多人音视频通话与聊天室，支持AI实时字幕翻译",
  "main": "server/app.js",
  "scripts": {
    "start": "node server/app.js",
    "dev": "nodemon server/app.js",
    "install-deps": "npm install",
    "clean": "rimraf node_modules",
    "reinstall": "npm run clean && npm install",
    "check-node": "node -v && npm -v",
    "prestart": "npm run check-node"
  },
  "keywords": [
    "webrtc",
    "video-chat",
    "socket.io",
    "peerjs",
    "ai-subtitle",
    "real-time-translation",
    "video-conference"
  ],
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "peer": "^1.0.2",
    "socket.io": "^4.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "rimraf": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/webrtc-video-chat.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/webrtc-video-chat/issues"
  },
  "homepage": "https://github.com/yourusername/webrtc-video-chat#readme",
  "os": [
    "win32",
    "darwin",
    "linux"
  ]
}